{
  "name": "readmesh",
  "version": "0.1.0",
  "private": true,
  "description": "readmesh — README Viewer AI (monorepo root)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter readmesh-backend run dev",
    "dev:web": "pnpm --filter readmesh-frontend run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . && pnpm --filter readmesh-frontend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter readmesh-backend run prisma:generate",
    "prisma:migrate": "pnpm --filter readmesh-backend run prisma:migrate",
    "db:seed": "pnpm --filter readmesh-backend run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
