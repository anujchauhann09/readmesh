# Runtime
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Database (REQUIRED) — PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/readmesh?schema=public


# Auth / JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

GITHUB_PAT=

# AI — Gemini (LLM + embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSION=768

# AI — Pinecone (RAG vector store). Index must be created with the SAME
# dimension as EMBED_DIMENSION and a cosine metric. PINECONE_HOST is optional
# (auto-resolved from the index name if omitted)
PINECONE_API_KEY=
PINECONE_INDEX=readmesh
PINECONE_HOST=
