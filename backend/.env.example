# Runtime
NODE_ENV=development
PORT=8080
# One origin, or several separated by commas. Also used as the CSRF allowlist.
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API. `false` when directly exposed (local dev),
# `1` behind Render. Trusting a proxy that isn't there lets clients forge
# X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=false

# Database (REQUIRED) — PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/readmesh?schema=public

# Auth / JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Pinned into every token and checked on verify.
JWT_ISSUER=readmesh
JWT_AUDIENCE=readmesh-api

# OAuth
# FRONTEND_URL is where the browser runs; the OAuth callback and password-reset
# pages live there.
FRONTEND_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must EXACTLY match the redirect URI registered in the provider console (the
# FRONTEND callback route — not the backend port).
GITHUB_CALLBACK_URL=http://localhost:3000/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/oauth/google/callback

# GitHub ingestion
GITHUB_PAT=
# The PAT raises the API rate limit; it can also usually read private repos, so
# serving them is opt-in and off by default.
ALLOW_PRIVATE_REPOS=false

# Email (password reset). `log` prints the message — including the reset link —
# to the application log, which is enough for local and free-tier use. Set
# `smtp` plus SMTP_URL to deliver for real.
MAIL_DRIVER=log
MAIL_FROM=readmesh <no-reply@readmesh.app>
SMTP_URL=

# AI — Gemini (LLM + embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSION=768

# AI — Pinecone (RAG vector store). Index must be created with the SAME
# dimension as EMBED_DIMENSION and a cosine metric. PINECONE_HOST is optional
# (auto-resolved from the index name if omitted)
PINECONE_API_KEY=
PINECONE_INDEX=readmesh
PINECONE_HOST=
