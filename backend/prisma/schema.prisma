generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GITHUB
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AnnotationType {
  HIGHLIGHT
  NOTE
  COMMENT
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           Int        @id @default(autoincrement())
  publicId     String     @unique @default(uuid()) @db.Uuid
  email        String     @unique
  /// Null for OAuth-only accounts that never set a password.
  passwordHash String?
  status       UserStatus @default(ACTIVE)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  profile       UserProfile?
  preferences   UserPreferences?
  authAccounts  AuthAccount[]
  refreshTokens RefreshToken[]
  annotations   Annotation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Set on soft delete; non-null means the account is deactivated/removed
  deletedAt DateTime?

  @@index([roleId])
  @@map("users")
}

model UserProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model UserPreferences {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String   @default("system")
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model AuthAccount {
  id                Int          @id @default(autoincrement())
  userId            Int
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  replacedById Int?          @unique
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  prevToken    RefreshToken? @relation("TokenRotation")

  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Annotation {
  id       Int            @id @default(autoincrement())
  publicId String         @unique @default(uuid()) @db.Uuid
  userId   Int
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     AnnotationType

  repoOwner String
  repoName  String
  repoRef   String
  filePath  String

  exact        String  @db.Text
  prefix       String? @db.Text
  suffix       String? @db.Text
  textPosition Int?

  sectionId    String?
  sectionTitle String?

  color String?
  body  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, repoOwner, repoName, repoRef, filePath])
  @@map("annotations")
}
